<!--pages/account/account.wxml-->
<!-- 账户页面 -->
<view class="account-page">
  <!-- 顶部用户信息卡片 -->
  <view class="user-card">
    <view class="user-avatar-section">
      <image class="user-avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.jpg'}}" mode="aspectFill" />
      <view class="user-basic-info">
        <text class="user-name">{{userInfo.username || '未登录'}}</text>
        <text class="user-id">学号: {{userInfo.student_id || '未绑定'}}</text>
        <text class="user-department">{{userInfo.college || '北京大学'}}</text>
      </view>
    </view>
    <view class="user-status">
      <text class="status-badge {{userInfo.role === 'student' ? 'student' : 'club_admin'}}">
        {{userInfo.role === 'student' ? '学生' : '社团管理员'}}
      </text>
    </view>
  </view>

  <!-- 账号信息详情 -->
  <view class="info-section">
    <view class="section-title">账号信息</view>
    
    <view class="info-item">
      <text class="info-label">用户名</text>
      <text class="info-value">{{userInfo.username || '未设置'}}</text>
    </view>
    
    <view class="info-item">
      <text class="info-label">学号/工号</text>
      <text class="info-value">{{userInfo.student_id || '未绑定'}}</text>
    </view>
    
    <view class="info-item">
      <text class="info-label">院系</text>
      <text class="info-value">{{userInfo.college || '未设置'}}</text>
    </view>
    
    <view class="info-item">
      <text class="info-label">专业</text>
      <text class="info-value">{{userInfo.major || '未设置'}}</text>
    </view>
    
    <view class="info-item">
      <text class="info-label">年级</text>
      <text class="info-value">{{userInfo.grade || '未设置'}}</text>
    </view>
    
    <view class="info-item">
      <text class="info-label">邮箱</text>
      <text class="info-value">{{userInfo.email || '未绑定'}}</text>
    </view>
    
    <view class="info-item">
      <text class="info-label">手机号</text>
      <text class="info-value">{{userInfo.phone || '未绑定'}}</text>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="bottom-actions">
    <button class="btn-logout" bindtap="onLogout">退出登录</button>
  </view>
</view>