/* pages/register/register.wxss */
.container {
  min-height: 100vh;
  background-color: #ffffff;
  padding: 80rpx 50rpx;
  display: flex;
  flex-direction: column;
}

.header {
  margin-bottom: 80rpx;
  margin-top: 60rpx;
}

.title {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 30rpx;
  color: #666666;
}

.form-container {
  width: 100%;
}

.input-group {
  margin-bottom: 60rpx;
}

.input-item {
  margin-bottom: 50rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.label {
  display: block;
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.input {
  font-size: 34rpx;
  color: #333333;
  height: 70rpx;
  line-height: 70rpx;
}

.placeholder {
  color: #cccccc;
  font-size: 30rpx;
}

.register-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background-color: #c20003;
  color: #ffffff;
  font-size: 34rpx;
  border-radius: 48rpx;
  margin-bottom: 50rpx;
  transition: all 0.3s;
}

.register-btn:active {
  background-color: #d63031;
  transform: scale(0.98);
}

.login-link {
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  margin-top: 40rpx;
}

.link {
  color: #c20003;
  margin-left: 10rpx;
  font-weight: 500;
}

.toggle-icon {
  width: 48rpx;
  height: 48rpx;
}

.password-input-container {
  width: 600rpx;
}

.password-toggle {
  position: absolute;
  right: 24rpx;
  transform: translateY(-100%);
  width: 60rpx;
  height: 60rpx;
}

/* 二选一选择器样式 - 与输入框风格统一 */
.selector-item {
  margin-bottom: 50rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.selector-label {
  display: block;
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

/* 选项容器 */
.options-container {
  display: flex;
  gap: 30rpx;
}

/* 单个选项样式 */
.option {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  font-size: 34rpx;
  color: #333333;
  text-align: center;
  border-radius: 8rpx;
  border: 2rpx solid #f0f0f0;
  background-color: #ffffff;
  transition: all 0.3s ease;
}

/* 选中状态 */
.option.selected {
  color: #333333;
  border-color: #333333;
  background-color: #f9f9f9;
  font-weight: 500;
}

/* 禁用状态 */
.option.disabled {
  color: #cccccc;
  border-color: #f0f0f0;
  background-color: #fafafa;
}

/* 提示文字 */
.selector-hint {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
  line-height: 1.4;
}