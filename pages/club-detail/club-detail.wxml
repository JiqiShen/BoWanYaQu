<!--pages/club-detail.wxml-->
<!-- 社团详情页面 -->
<view class="container">

  <!-- 社团基本信息 -->
  <view class="section" style="height: 210rpx; display: block; box-sizing: border-box">
    <!-- 社团名称 -->
    <view class="title-row">
      <text class="club-name">{{clubData.name}}</text>
    </view>

    <!-- 社团标签 -->
    <view class="tags">
      <block wx:for="{{clubData.tags}}" wx:key="index">
        <text class="tag">{{item}}</text>
      </block>
    </view>
  </view>

  <!-- 社团详情 -->
  <view class="section">
    <text class="section-title">社团详情</text>
    <!-- 社团详情内容引用位置 -->
    <text class="detail-content">{{clubData.description}}</text>
  </view>

  <!-- 社团人数 -->
  <view class="section">
    <text class="section-title">社团人数</text>
    <!-- 社团人数引用位置 -->
    <text class="detail-content">{{clubData.member_count}}人</text>
  </view>

  <!-- 社团联系人  -->
  <view class="section">
    <text class="section-title">社团联系人</text>
    <!-- 社团联系人引用位置 -->
    <text class="detail-content">{{clubData.contact}}</text>
  </view>

  <!-- 关注按钮 -->
  <view class="action-buttons">
    <button class="btn {{clubData.is_followed ? 'btn-disabled' : 'btn-primary'}}" bindtap="onRegisterTap" disabled="{{clubData.is_followed}}">
      {{clubData.is_followed ? '已关注' : '关注社团'}}
    </button>
  </view>
</view>