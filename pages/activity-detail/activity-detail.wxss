.container {
  min-height: 100vh;
  background-color: #f9f9f9;
  padding: 20rpx;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.activity-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.status-tag {
  background-color: #d32f2fa4;
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: bold;
  white-space: nowrap;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  background-color: #ffebee;
  color: #d32f2f;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-right: 20rpx;
  margin-bottom: 15rpx;
}

.section-title {
  font-size: 32rpx;
  color: #d32f2f;
  font-weight: bold;
  display: block;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #d32f2f;
  padding-left: 20rpx;
}

.detail-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.info-icon {
  width: 40rpx;
  margin-right: 20rpx;
  color: #d32f2f;
  font-size: 28rpx;
}

.info-text {
  flex: 1;
  font-size: 28rpx;
  color: #555;
}

.registration-info {
  display: flex;
  justify-content: space-between;
  background-color: #ffebee;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-top: 20rpx;
}

.registration-count {
  font-size: 26rpx;
  color: #d32f2f;
  font-weight: bold;
}

.follow-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.follow-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.follow-switch {
  transform: scale(0.9);
}

.action-buttons {
  padding: 0 20rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background-color: #d32f2f;
  color: #fff;
}

.btn-disabled {
  background-color: #cccccc;
  color: #666;
}