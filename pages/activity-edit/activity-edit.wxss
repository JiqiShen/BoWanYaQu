/* pages/publish-activity/publish-activity.wxss */
.container {
  padding: 20rpx;
  background-color: #ffffff;
  min-height: 100vh;
}

.header {
  margin-bottom: 40rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #d81e06;
}

.form-item {
  margin-bottom: 40rpx;
  padding: 0 20rpx;
}

.label {
  display: block;
  font-size: 30rpx;
  color: #333333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  transition: border-color 0.3s;
}

.input:focus {
  border-color: #d81e06;
}

.textarea {
  width: 100%;
  height: 200rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  transition: border-color 0.3s;
}

.textarea:focus {
  border-color: #d81e06;
}

/* 时间选择器样式 */
.time-picker-container {
  width: 100%;
}

.time-section {
  margin-bottom: 30rpx;
}

.time-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.time-input-group {
  display: flex;
  justify-content: space-between;
}

.date-picker, .time-picker {
  width: 48%;
}

.picker-text {
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333;
  background-color: #f9f9f9;
}

.picker-text:active {
  background-color: #f0f0f0;
}

.full-time-display {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #fef2f2;
  border-radius: 10rpx;
  border-left: 4rpx solid #d81e06;
}

.full-time-text {
  font-size: 26rpx;
  color: #d81e06;
  font-weight: 500;
}

.ai-section {
  margin: 50rpx 0;
  text-align: center;
}

.ai-button {
  display: inline-flex;
  align-items: center;
  padding: 20rpx 40rpx;
  background-color: #fef2f2;
  border: 2rpx dashed #d81e06;
  border-radius: 50rpx;
  color: #d81e06;
  font-size: 28rpx;
  transition: all 0.3s ease;
}

.ai-button:active {
  transform: scale(0.98);
  background-color: #ffeaea;
}

.ai-icon {
  margin-right: 10rpx;
  font-size: 32rpx;
}

.ai-text {
  font-weight: 500;
}

/* 输入框容器 */
.ai-input-container {
  margin-top: 30rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.1);
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 输入框头部 */
.ai-input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.ai-input-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.ai-input-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx 20rpx;
  line-height: 1;
}

.ai-input-close:active {
  color: #666;
}

/* 文本输入框 */
.ai-textarea {
  width: 100%;
  text-align: left;
  min-height: 200rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #333;
  border: 2rpx solid #eee;
  box-sizing: border-box;
}

.ai-textarea:focus {
  border-color: #d81e06;
  background: #fff;
}

/* 输入框底部 */
.ai-input-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.ai-char-count {
  font-size: 24rpx;
  color: #999;
}

.ai-submit-btn {
  background: linear-gradient(135deg, #d81e06 0%, #ff6b6b 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.ai-submit-btn:active {
  opacity: 0.9;
}

.button-container {
  margin-top: 60rpx;
  padding: 0 20rpx;
}

.publish-button {
  width: 100%;
  height: 90rpx;
  background-color: #d81e06;
  color: white;
  border-radius: 45rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.publish-button:active {
  background-color: #b71c1c;
}