<!-- pages/publish-activity/publish-activity.wxml -->
<view class="container">
  <view class="header">
    <text class="title">发布社团活动</text>
  </view>
  
  <form bindsubmit="onFormSubmit">
    <!-- 活动名称 -->
    <view class="form-item">
      <text class="label">活动名称</text>
      <input 
        name="name" 
        class="input" 
        placeholder="请输入活动名称" 
        value="{{name}}"
      />
    </view>
    
    <!-- 活动时间 -->
    <view class="form-item">
      <text class="label">活动时间</text>
      <view class="time-picker-container">
        <view class="time-section">
          <text class="time-label">开始时间</text>
          <view class="time-input-group">
            <picker 
              mode="date" 
              value="{{startDate}}" 
              bindchange="onStartDateChange"
              class="date-picker"
            >
              <view class="picker-text">{{startDate || '选择日期'}}</view>
            </picker>
            <picker 
              mode="time" 
              value="{{startTime}}" 
              bindchange="onStartTimeChange"
              class="time-picker"
            >
              <view class="picker-text">{{startTime || '选择时间'}}</view>
            </picker>
          </view>
        </view>
        
        <view class="time-section">
          <text class="time-label">结束时间</text>
          <view class="time-input-group">
            <picker 
              mode="date" 
              value="{{endDate}}" 
              bindchange="onEndDateChange"
              class="date-picker"
            >
              <view class="picker-text">{{endDate || '选择日期'}}</view>
            </picker>
            <picker 
              mode="time" 
              value="{{endTime}}" 
              bindchange="onEndTimeChange"
              class="time-picker"
            >
              <view class="picker-text">{{endTime || '选择时间'}}</view>
            </picker>
          </view>
        </view>
        
        <!-- 显示完整时间 -->
        <view class="full-time-display" wx:if="{{startDate && startTime && endDate && endTime}}">
          <text class="full-time-text">{{formatFullTime()}}</text>
        </view>
      </view>
    </view>
    
    <!-- 活动地点 -->
    <view class="form-item">
      <text class="label">活动地点</text>
      <input 
        name="location" 
        class="input" 
        placeholder="请输入活动地点" 
        value="{{location}}"
      />
    </view>
    
    <!-- 活动标签 -->
    <view class="form-item">
      <text class="label">活动标签</text>
      <input 
        name="tags" 
        class="input" 
        placeholder="用逗号分隔，例如：文学,读书会,推理" 
        value="{{tags}}"
      />
    </view>
    
    <!-- 活动详情 -->
    <view class="form-item">
      <text class="label">活动详情</text>
      <textarea 
        name="detail" 
        class="textarea" 
        placeholder="请输入活动详情" 
        value="{{description}}"
      ></textarea>
    </view>
    
    <!-- 活动人数 -->
    <view class="form-item">
      <text class="label">活动总人数</text>
      <input 
        name="totalCount" 
        class="input" 
        type="number" 
        placeholder="请输入活动总人数" 
        value=""
      />
    </view>
    
    <!-- AI快速填写入口 -->
    <view class="ai-section">
      <view class="ai-button" bindtap="onAIAssistTap">
        <text class="ai-icon">⚡</text>
        <text class="ai-text">AI快速填写</text>
      </view>
      <!-- 点击后显示的输入框 -->
      <view class="ai-input-container" wx:if="{{showAISection}}">
        <view class="ai-input-header">
          <text class="ai-input-title">请输入活动信息或微信公众号链接</text>
          <text class="ai-input-close" bindtap="onCloseAISection">×</text>
        </view>
        <textarea 
          class="ai-textarea" 
          placeholder="例如：帮我写一份关于环保的社团活动策划..." 
          value="{{aiInputText}}"
          bindinput="onAIInput"
          maxlength="500"
          auto-height
        />
        <view class="ai-input-footer">
          <text class="ai-char-count">{{aiInputText.length}}/500</text>
          <button class="ai-submit-btn" bindtap="onAISubmit">生成</button>
        </view>
      </view>
    </view>
    
    <!-- 发布按钮 -->
    <view class="button-container">
      <button class="publish-button" form-type="submit">发布活动</button>
    </view>
  </form>
</view>