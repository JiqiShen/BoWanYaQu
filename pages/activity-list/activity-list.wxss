/* pages/activity-list/activity-list.wxss */

/* 页面整体样式 */
.activity-page {
  min-height: 100vh;           /* 最小高度为视口高度 */
  background-color: #f9f2f2;   /* 浅红色背景 */
  padding-bottom: 40rpx;       /* 底部内边距 */
}

/* 搜索区域样式 */
.search-section {
  padding: 30rpx;              /* 内边距 */
  background: linear-gradient(135deg, #d81e06, #ff4d4f);  /* 红色渐变背景 */
  box-shadow: 0 4rpx 20rpx rgba(216, 30, 6, 0.3);  /* 阴影效果 */
}

.search-container {
  position: relative;          /* 相对定位 */
  background: #fff;            /* 白色背景 */
  border-radius: 50rpx;        /* 圆角 */
  padding: 20rpx 30rpx;        /* 内边距 */
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);  /* 阴影 */
}

.search-input {
  width: 100%;                 /* 宽度100% */
  font-size: 28rpx;            /* 字体大小 */
  padding-left: 60rpx;         /* 左侧内边距，为图标留空间 */
}

.search-icon {
  position: absolute;          /* 绝对定位 */
  left: 30rpx;                 /* 左侧位置 */
  top: 50%;                    /* 垂直居中 */
  transform: translateY(-50%); /* 垂直居中修正 */
  font-size: 32rpx;            /* 图标大小 */
  color: #d81e06;              /* 红色图标 */
}

/* 筛选区域样式 */
.filter-section {
  background: #fff;            /* 白色背景 */
  margin: 0 30rpx;             /* 左右外边距 */
  border-radius: 16rpx;        /* 圆角 */
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);  /* 阴影 */
  overflow: hidden;             /* 隐藏溢出内容 */
  margin-top: -20rpx;          /* 负外边距，与搜索栏重叠 */
  position: relative;          /* 相对定位 */
  z-index: 10;                 /* 层级 */
}

.filter-header {
  display: flex;               /* 弹性布局 */
  justify-content: space-between;  /* 两端对齐 */
  align-items: center;         /* 垂直居中 */
  padding: 30rpx;              /* 内边距 */
  border-bottom: 1rpx solid #f0f0f0;  /* 底部边框 */
}

.filter-title {
  font-size: 32rpx;            /* 字体大小 */
  font-weight: 600;            /* 字体粗细 */
  color: #333;                 /* 字体颜色 */
}

.filter-toggle {
  display: flex;               /* 弹性布局 */
  align-items: center;         /* 垂直居中 */
  color: #d81e06;              /* 红色 */
  font-size: 26rpx;            /* 字体大小 */
}

.toggle-text {
  margin-right: 10rpx;         /* 右侧外边距 */
}

.toggle-arrow {
  font-size: 20rpx;            /* 箭头大小 */
  transition: transform 0.3s ease;  /* 旋转动画 */
}

/* 展开时箭头旋转 */
.filter-toggle.expanded .toggle-arrow {
  transform: rotate(180deg);
}

/* 筛选内容区域 */
.filter-content {
  max-height: 0;               /* 初始高度为0 */
  overflow: hidden;             /* 隐藏溢出内容 */
  transition: max-height 0.3s ease;  /* 高度变化动画 */
}

/* 展开时设置最大高度 */
.filter-content.expanded {
  max-height: 800rpx;
}

.filter-group {
  padding: 30rpx;              /* 内边距 */
  border-bottom: 1rpx solid #f5f5f5;  /* 底部边框 */
}

.filter-group:last-child {
  border-bottom: none;         /* 最后一个去除底部边框 */
}

.filter-label {
  display: block;              /* 块级元素 */
  font-size: 28rpx;            /* 字体大小 */
  color: #666;                 /* 字体颜色 */
  margin-bottom: 20rpx;        /* 底部外边距 */
  font-weight: 500;            /* 字体粗细 */
}

.filter-options {
  display: flex;               /* 弹性布局 */
  flex-wrap: wrap;             /* 允许换行 */
  gap: 20rpx;                  /* 选项间距 */
}

.filter-option {
  padding: 12rpx 24rpx;        /* 内边距 */
  background: #f5f5f5;         /* 背景色 */
  border-radius: 30rpx;        /* 圆角 */
  font-size: 26rpx;            /* 字体大小 */
  color: #666;                 /* 字体颜色 */
  transition: all 0.3s ease;   /* 过渡动画 */
}

/* 激活状态的筛选选项 */
.filter-option.active {
  background: #d81e06;         /* 红色背景 */
  color: #fff;                 /* 白色文字 */
  box-shadow: 0 4rpx 12rpx rgba(216, 30, 6, 0.3);  /* 阴影 */
}

.date-picker {
  padding: 20rpx;              /* 内边距 */
  background: #f5f5f5;         /* 背景色 */
  border-radius: 12rpx;        /* 圆角 */
  text-align: center;          /* 文字居中 */
  color: #999;                 /* 字体颜色 */
  font-size: 28rpx;            /* 字体大小 */
}

/* 有值的日期选择器 */
.date-picker.has-value {
  color: #333;                 /* 深色文字 */
  background: #ffeceb;         /* 浅红色背景 */
  border: 1rpx solid #d81e06;  /* 红色边框 */
}

.filter-actions {
  padding: 30rpx;              /* 内边距 */
  text-align: center;          /* 文字居中 */
}

.reset-btn {
  display: inline-block;       /* 行内块元素 */
  padding: 20rpx 40rpx;        /* 内边距 */
  background: #f5f5f5;         /* 背景色 */
  border-radius: 30rpx;        /* 圆角 */
  font-size: 28rpx;            /* 字体大小 */
  color: #666;                 /* 字体颜色 */
}

/* 活动列表区域 */
.activity-list-section {
  padding: 30rpx;              /* 内边距 */
}

.loading-container {
  display: flex;               /* 弹性布局 */
  flex-direction: column;      /* 垂直方向 */
  align-items: center;         /* 水平居中 */
  padding: 100rpx 0;           /* 内边距 */
}

/* 加载动画 */
.loading-spinner {
  width: 60rpx;                /* 宽度 */
  height: 60rpx;               /* 高度 */
  border: 6rpx solid #f0f0f0;  /* 边框 */
  border-top: 6rpx solid #d81e06;  /* 顶部边框为红色 */
  border-radius: 50%;          /* 圆形 */
  animation: spin 1s linear infinite;  /* 旋转动画 */
  margin-bottom: 20rpx;        /* 底部外边距 */
}

/* 旋转动画定义 */
@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;            /* 字体大小 */
  color: #999;                 /* 字体颜色 */
}

.activity-list {
  display: flex;               /* 弹性布局 */
  flex-direction: column;      /* 垂直方向 */
  gap: 30rpx;                  /* 项间距 */
}

/* 活动项样式 */
.activity-item {
  background: #fff;            /* 白色背景 */
  border-radius: 20rpx;        /* 圆角 */
  overflow: hidden;             /* 隐藏溢出内容 */
  box-shadow: 0 6rpx 25rpx rgba(0, 0, 0, 0.08);  /* 阴影 */
  transition: transform 0.3s ease, box-shadow 0.3s ease;  /* 过渡动画 */
}

/* 活动项点击效果 */
.activity-item:active {
  transform: translateY(-4rpx);  /* 上移效果 */
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.15);  /* 加深阴影 */
}

.activity-cover-container {
  position: relative;          /* 相对定位 */
  height: 300rpx;              /* 固定高度 */
}

.activity-cover {
  width: 100%;                 /* 宽度100% */
  height: 100%;                /* 高度100% */
  background: linear-gradient(135deg, #d81e06, #ff7a7a);  /* 红色渐变背景 */
}

/* 活动状态标签 */
.activity-status {
  position: absolute;          /* 绝对定位 */
  top: 20rpx;                  /* 顶部位置 */
  right: 20rpx;                /* 右侧位置 */
  padding: 8rpx 20rpx;         /* 内边距 */
  border-radius: 30rpx;        /* 圆角 */
  font-size: 22rpx;            /* 字体大小 */
  color: #fff;                 /* 白色文字 */
  font-weight: 500;            /* 字体粗细 */
}

/* 进行中状态 - 绿色 */
.activity-status.ongoing {
  background: rgba(7, 193, 96, 0.9);
}

/* 已结束状态 - 灰色 */
.activity-status.ended {
  background: rgba(153, 153, 153, 0.9);
}

/* 未开始状态 - 蓝色 */
.activity-status.upcoming {
  background: rgba(24, 144, 255, 0.9);
}

/* 社团标识 */
.club-badge {
  position: absolute;          /* 绝对定位 */
  top: 20rpx;                  /* 顶部位置 */
  left: 20rpx;                 /* 左侧位置 */
  padding: 8rpx 16rpx;         /* 内边距 */
  background: rgba(216, 30, 6, 0.9);  /* 半透明红色背景 */
  color: #fff;                 /* 白色文字 */
  border-radius: 8rpx;         /* 圆角 */
  font-size: 22rpx;            /* 字体大小 */
  font-weight: 500;            /* 字体粗细 */
}

/* 可参加标识 - 新增 */
.available-badge {
  position: absolute;          /* 绝对定位 */
  bottom: 20rpx;               /* 底部位置 */
  right: 20rpx;                /* 右侧位置 */
  padding: 6rpx 12rpx;         /* 内边距 */
  background: rgba(7, 193, 96, 0.9);  /* 半透明绿色背景 */
  color: #fff;                 /* 白色文字 */
  border-radius: 6rpx;         /* 圆角 */
  font-size: 20rpx;            /* 字体大小 */
  font-weight: 500;            /* 字体粗细 */
}

/* 活动信息样式 */
.activity-info {
  padding: 30rpx;              /* 内边距 */
}

.activity-header {
  display: flex;               /* 弹性布局 */
  justify-content: space-between;  /* 两端对齐 */
  align-items: flex-start;     /* 顶部对齐 */
  margin-bottom: 20rpx;        /* 底部外边距 */
}

.activity-title {
  flex: 1;                     /* 占据剩余空间 */
  font-size: 32rpx;            /* 字体大小 */
  font-weight: 600;            /* 字体粗细 */
  color: #333;                 /* 字体颜色 */
  line-height: 1.4;            /* 行高 */
  margin-right: 20rpx;         /* 右侧外边距 */
  display: -webkit-box;        /* 弹性盒子 */
  -webkit-line-clamp: 2;       /* 限制两行 */
  -webkit-box-orient: vertical;  /* 垂直方向 */
  overflow: hidden;             /* 隐藏溢出内容 */
}

.activity-type {
  padding: 8rpx 16rpx;         /* 内边距 */
  background: #ffeceb;         /* 浅红色背景 */
  color: #d81e06;              /* 红色文字 */
  border-radius: 8rpx;         /* 圆角 */
  font-size: 22rpx;            /* 字体大小 */
  white-space: nowrap;         /* 不换行 */
}

.activity-description {
  font-size: 26rpx;            /* 字体大小 */
  color: #666;                 /* 字体颜色 */
  line-height: 1.5;            /* 行高 */
  margin-bottom: 20rpx;        /* 底部外边距 */
  display: -webkit-box;        /* 弹性盒子 */
  -webkit-line-clamp: 2;       /* 限制两行 */
  -webkit-box-orient: vertical;  /* 垂直方向 */
  overflow: hidden;             /* 隐藏溢出内容 */
}

/* 活动详细信息样式 */
.activity-details {
  background: #f9f9f9;         /* 浅灰色背景 */
  border-radius: 12rpx;        /* 圆角 */
  padding: 20rpx;              /* 内边距 */
  margin-bottom: 20rpx;        /* 底部外边距 */
}

.detail-item {
  display: flex;               /* 弹性布局 */
  justify-content: space-between;  /* 两端对齐 */
  align-items: center;         /* 垂直居中 */
  margin-bottom: 12rpx;        /* 底部外边距 */
}

.detail-item:last-child {
  margin-bottom: 0;            /* 最后一个去除底部外边距 */
}

.detail-label {
  font-size: 24rpx;            /* 字体大小 */
  color: #999;                 /* 字体颜色 */
}

.detail-value {
  font-size: 24rpx;            /* 字体大小 */
  color: #666;                 /* 字体颜色 */
  font-weight: 500;            /* 字体粗细 */
}

.activity-meta {
  margin-bottom: 20rpx;        /* 底部外边距 */
}

.meta-item {
  display: flex;               /* 弹性布局 */
  align-items: center;         /* 垂直居中 */
  margin-bottom: 15rpx;        /* 底部外边距 */
}

.meta-item:last-child {
  margin-bottom: 0;            /* 最后一个去除底部外边距 */
}

.meta-icon {
  margin-right: 15rpx;         /* 右侧外边距 */
  font-size: 24rpx;            /* 图标大小 */
}

.meta-text {
  font-size: 26rpx;            /* 字体大小 */
  color: #666;                 /* 字体颜色 */
}

.activity-footer {
  display: flex;               /* 弹性布局 */
  justify-content: flex-end;   /* 右对齐 */
  align-items: center;         /* 垂直居中 */
  padding-top: 20rpx;          /* 顶部内边距 */
  border-top: 1rpx solid #f0f0f0;  /* 顶部边框 */
}

.activity-actions {
  display: flex;               /* 弹性布局 */
  align-items: center;         /* 垂直居中 */
}

.action-btn {
  display: flex;               /* 弹性布局 */
  align-items: center;         /* 垂直居中 */
  padding: 12rpx 20rpx;        /* 内边距 */
  border-radius: 30rpx;        /* 圆角 */
  transition: all 0.3s ease;   /* 过渡动画 */
  font-size: 26rpx;            /* 字体大小 */
}

/* 按钮点击效果 */
.action-btn:active {
  background-color: #f5f5f5;   /* 背景色变化 */
  transform: scale(0.95);      /* 缩放效果 */
}

.like-btn {
  background: #fff5f5;         /* 浅红色背景 */
  color: #666;                 /* 字体颜色 */
  border: 1rpx solid #ffccc7;  /* 边框 */
}

/* 已点赞状态 */
.like-btn.liked {
  background: #fff0f0;         /* 红色背景 */
  color: #d81e06;              /* 红色文字 */
  border: 1rpx solid #d81e06;  /* 红色边框 */
}

.action-icon {
  margin-right: 8rpx;          /* 右侧外边距 */
  font-size: 28rpx;            /* 图标大小 */
}

.action-count {
  font-size: 24rpx;            /* 字体大小 */
  color: inherit;              /* 继承父元素颜色 */
}

/* 空状态样式 */
.empty-state {
  display: flex;               /* 弹性布局 */
  flex-direction: column;      /* 垂直方向 */
  align-items: center;         /* 水平居中 */
  padding: 120rpx 0;           /* 内边距 */
  text-align: center;          /* 文字居中 */
}

.empty-image {
  width: 200rpx;               /* 图片宽度 */
  height: 200rpx;              /* 图片高度 */
  margin-bottom: 30rpx;        /* 底部外边距 */
  opacity: 0.6;                /* 透明度 */
}

.empty-text {
  font-size: 32rpx;            /* 字体大小 */
  color: #999;                 /* 字体颜色 */
  margin-bottom: 15rpx;        /* 底部外边距 */
}

.empty-desc {
  font-size: 26rpx;            /* 字体大小 */
  color: #ccc;                 /* 字体颜色 */
}

/* 翻页控件样式 */
.pagination-section {
  padding: 30rpx;              /* 内边距 */
  background: #fff;            /* 白色背景 */
  margin: 0 30rpx;             /* 左右外边距 */
  border-radius: 16rpx;        /* 圆角 */
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);  /* 阴影 */
  display: flex;               /* 弹性布局 */
  justify-content: space-between;  /* 两端对齐 */
  align-items: center;         /* 垂直居中 */
}

.pagination-container {
  display: flex;               /* 弹性布局 */
  align-items: center;         /* 垂直居中 */
  gap: 30rpx;                  /* 项间距 */
}

.page-btn {
  padding: 20rpx 40rpx;        /* 内边距 */
  background: #d81e06;         /* 红色背景 */
  color: #fff;                 /* 白色文字 */
  border-radius: 30rpx;        /* 圆角 */
  font-size: 28rpx;            /* 字体大小 */
  font-weight: 500;            /* 字体粗细 */
  transition: all 0.3s ease;   /* 过渡动画 */
  box-shadow: 0 4rpx 12rpx rgba(216, 30, 6, 0.3);  /* 阴影 */
}

/* 翻页按钮点击效果 */
.page-btn:active {
  transform: scale(0.95);      /* 缩放效果 */
  box-shadow: 0 2rpx 6rpx rgba(216, 30, 6, 0.5);  /* 阴影变化 */
}

/* 禁用状态的翻页按钮 */
.page-btn.disabled {
  background: #ccc;            /* 灰色背景 */
  box-shadow: none;            /* 无阴影 */
  pointer-events: none;        /* 禁止点击 */
}

.page-info {
  display: flex;               /* 弹性布局 */
  align-items: center;         /* 垂直居中 */
  font-size: 28rpx;            /* 字体大小 */
  color: #333;                 /* 字体颜色 */
}

.current-page {
  color: #d81e06;              /* 红色 */
  font-weight: 600;            /* 字体粗细 */
}

.page-separator {
  margin: 0 10rpx;             /* 左右外边距 */
  color: #999;                 /* 字体颜色 */
}

.page-jump {
  display: flex;               /* 弹性布局 */
  align-items: center;         /* 垂直居中 */
  gap: 15rpx;                  /* 项间距 */
}

.jump-input {
  width: 100rpx;               /* 固定宽度 */
  padding: 15rpx;              /* 内边距 */
  border: 1rpx solid #ddd;     /* 边框 */
  border-radius: 8rpx;         /* 圆角 */
  text-align: center;          /* 文字居中 */
  font-size: 26rpx;            /* 字体大小 */
}

.jump-text {
  font-size: 26rpx;            /* 字体大小 */
  color: #666;                 /* 字体颜色 */
}

/* 创建活动悬浮按钮 */
.floating-btn {
  position: fixed;             /* 固定定位 */
  right: 40rpx;                /* 右侧位置 */
  bottom: 120rpx;              /* 底部位置 */
  background: linear-gradient(135deg, #d81e06, #ff4d4f);  /* 红色渐变背景 */
  color: #fff;                 /* 白色文字 */
  border-radius: 50rpx;        /* 圆角 */
  padding: 20rpx 30rpx;        /* 内边距 */
  display: flex;               /* 弹性布局 */
  align-items: center;         /* 垂直居中 */
  gap: 10rpx;                  /* 项间距 */
  box-shadow: 0 8rpx 25rpx rgba(216, 30, 6, 0.4);  /* 阴影 */
  z-index: 1000;               /* 高层级 */
  transition: all 0.3s ease;   /* 过渡动画 */
}

/* 悬浮按钮点击效果 */
.floating-btn:active {
  transform: scale(0.95);      /* 缩放效果 */
  box-shadow: 0 4rpx 12rpx rgba(216, 30, 6, 0.6);  /* 阴影变化 */
}

.btn-text {
  font-size: 32rpx;            /* 字体大小 */
  font-weight: bold;           /* 字体粗细 */
}

.btn-label {
  font-size: 26rpx;            /* 字体大小 */
}

/* 响应式设计 - 适配大屏幕设备 */
@media (min-width: 768px) {
  .activity-page {
    max-width: 750px;          /* 最大宽度 */
    margin: 0 auto;            /* 水平居中 */
  }
}
