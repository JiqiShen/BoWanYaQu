/* pages/activity-list/activity-list.wxss */

/* 页面整体样式 */
.activity-page {
  min-height: 100vh;
  background-color: #f9f2f2;
  padding-bottom: 40rpx;
}

/* 搜索区域样式 */
.search-section {
  padding: 30rpx;
  background: linear-gradient(135deg, #d81e06, #ff4d4f);
  box-shadow: 0 4rpx 20rpx rgba(216, 30, 6, 0.3);
}

.search-container {
  position: relative;
  background: #fff;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
}

.search-input {
  width: 100%;
  font-size: 28rpx;
  padding-left: 60rpx;
}

.search-icon {
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #d81e06;
}

/* 筛选区域样式 */
.filter-section {
  background: #fff;
  margin: 0 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  margin-top: -20rpx;
  position: relative;
  z-index: 10;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.filter-toggle {
  display: flex;
  align-items: center;
  color: #d81e06;
  font-size: 26rpx;
}

.toggle-text {
  margin-right: 10rpx;
}

.toggle-arrow {
  font-size: 20rpx;
  transition: transform 0.3s ease;
}

.filter-toggle.expanded .toggle-arrow {
  transform: rotate(180deg);
}

/* 筛选内容区域 */
.filter-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.filter-content.expanded {
  max-height: 500rpx;
}

.filter-group {
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.filter-group:last-child {
  border-bottom: none;
}

.filter-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.filter-option {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s ease;
}

.filter-option.active {
  background: #d81e06;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(216, 30, 6, 0.3);
}

.date-picker {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.date-picker.has-value {
  color: #333;
  background: #ffeceb;
  border: 1rpx solid #d81e06;
}

.filter-actions {
  padding: 30rpx;
  text-align: center;
}

.reset-btn {
  display: inline-block;
  padding: 20rpx 40rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
}

/* 活动列表区域 */
.activity-list-section {
  padding: 30rpx;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid #f0f0f0;
  border-top: 6rpx solid #d81e06;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

/* 活动项样式 */
.activity-item {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 25rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.activity-item:active {
  transform: translateY(-4rpx);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.15);
}

.activity-cover-container {
  position: relative;
  height: 300rpx;
}

.activity-cover {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #d81e06, #ff7a7a);
}

.activity-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

.activity-status.ongoing {
  background: rgba(7, 193, 96, 0.9);
}

.activity-status.ended {
  background: rgba(153, 153, 153, 0.9);
}

.activity-status.upcoming {
  background: rgba(24, 144, 255, 0.9);
}

.club-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 8rpx 16rpx;
  background: rgba(216, 30, 6, 0.9);
  color: #fff;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* 活动信息样式 */
.activity-info {
  padding: 30rpx;
}

.activity-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.activity-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-right: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.activity-type {
  padding: 8rpx 16rpx;
  background: #ffeceb;
  color: #d81e06;
  border-radius: 8rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.activity-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 25rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.activity-meta {
  margin-bottom: 25rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.meta-item:last-child {
  margin-bottom: 0;
}

.meta-icon {
  margin-right: 15rpx;
  font-size: 24rpx;
}

.meta-text {
  font-size: 26rpx;
  color: #666;
}

.activity-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.activity-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 30rpx;
  transition: all 0.3s ease;
  font-size: 26rpx;
}

.action-btn:active {
  background-color: #f5f5f5;
  transform: scale(0.95);
}

.contact-btn {
  background: #f0f7ff;
  color: #1890ff;
  border: 1rpx solid #1890ff;
}

.like-btn {
  background: #fff5f5;
  color: #666;
  border: 1rpx solid #ffccc7;
}

.like-btn.liked {
  background: #fff0f0;
  color: #d81e06;
  border: 1rpx solid #d81e06;
}

.action-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.action-text, .action-count {
  font-size: 24rpx;
  color: inherit;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  text-align: center;
}

.empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 15rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #ccc;
}

/* 翻页控件样式 */
.pagination-section {
  padding: 30rpx;
  background: #fff;
  margin: 0 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pagination-container {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.page-btn {
  padding: 20rpx 40rpx;
  background: #d81e06;
  color: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(216, 30, 6, 0.3);
}

.page-btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(216, 30, 6, 0.5);
}

.page-btn.disabled {
  background: #ccc;
  box-shadow: none;
  pointer-events: none;
}

.page-info {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}

.current-page {
  color: #d81e06;
  font-weight: 600;
}

.page-separator {
  margin: 0 10rpx;
  color: #999;
}

.page-jump {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.jump-input {
  width: 100rpx;
  padding: 15rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
}

.jump-text {
  font-size: 26rpx;
  color: #666;
}

/* 创建活动悬浮按钮 */
.floating-btn {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  background: linear-gradient(135deg, #d81e06, #ff4d4f);
  color: #fff;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 8rpx 25rpx rgba(216, 30, 6, 0.4);
  z-index: 1000;
  transition: all 0.3s ease;
}

.floating-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 12rpx rgba(216, 30, 6, 0.6);
}

.btn-text {
  font-size: 32rpx;
  font-weight: bold;
}

.btn-label {
  font-size: 26rpx;
}

/* 响应式设计 */
@media (min-width: 768px) {
  .activity-page {
    max-width: 750px;
    margin: 0 auto;
  }
}
