<!-- pages/calendar/calendar.wxml -->
<view class="calendar-page">
  <!-- 日历头部 -->
  <view class="calendar-header">
    <view class="header-title">
      <text class="title-text">活动日历</text>
      <text class="subtitle">{{year}}年{{month}}月</text>
    </view>
    
    <!-- 视图切换 -->
    <view class="view-switcher">
      <view 
        class="view-item {{currentView === 'month' ? 'active' : ''}}" 
        data-view="month" 
        bindtap="onViewChange"
      >
        <text>月视图</text>
      </view>
      <view 
        class="view-item {{currentView === 'week' ? 'active' : ''}}" 
        data-view="week" 
        bindtap="onViewChange"
      >
        <text>周视图</text>
      </view>
    </view>
  </view>

  <!-- 月视图 -->
  <view class="calendar-month-view" wx:if="{{currentView === 'month'}}">
    <!-- 星期标题 -->
    <view class="week-header">
      <view class="weekday" wx:for="{{['日', '一', '二', '三', '四', '五', '六']}}">
        <text>{{item}}</text>
      </view>
    </view>
    
    <!-- 日历日期 -->
    <view class="calendar-days">
      <view 
        class="day-item {{item.isCurrentMonth ? 'current-month' : 'other-month'}} {{item.isToday ? 'today' : ''}} {{item.date === selectedDate ? 'selected' : ''}}"
        wx:for="{{days}}"
        wx:key="date"
        data-date="{{item.date}}"
        bindtap="onDateSelect"
      >
        <text class="day-number">{{item.day}}</text>
        <!-- 活动标记 -->
        <view 
          class="activity-dot {{getActivitiesCount(item.date) > 0 ? 'has-activities' : ''}}"
        >
          <text>{{getActivitiesCount(item.date)}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 周视图 -->
  <view class="calendar-week-view" wx:if="{{currentView === 'week'}}">
      <!-- 周数显示 -->
      <view class="week-indicator">
        <text>第{{currentWeek}}周</text>
    </view>
    
    <view class="week-days">
      <view 
        class="week-day {{item.date === selectedDate ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}">
        <view class="week-day-header">
          <text class="weekday">{{['日', '一', '二', '三', '四', '五', '六'][item.weekday]}} {{item.day}}</text>
        </view>
        
        <!-- 该日的活动 -->
        <view class="week-activities">
          <view 
            class="activity-item" 
            wx:for="{{getActivitiesByDate(item.date)}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onActivitySelect"
        wx:for-item="activity"
      >
            <text class="activity-time">{{formatActivityTime(activity.startTime)}}</text>
            <text class="activity-title">{{activity.title}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 活动列表 -->
  <view class="activities-section">
    <view class="section-header">
      <text class="section-title">{{selectedDate ? getDateDisplayText(selectedDate) : '请选择日期'}}</text>
    </view>
    
    <view class="activities-list">
      <view 
        class="activity-card {{activity.id === selectedActivity.id ? 'selected' : ''}}"
        wx:for="{{filteredActivities}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onGoToActivityDetail"
        wx:for-item="activity"
      >
        <view class="activity-time">
          <text>{{formatActivityTime(activity.startTime)}}</text>
        </view>
      </view>
      
      <view class="activity-info">
        <text class="activity-title">{{activity.title}}</text>
        <text class="activity-location">{{activity.location}}</text>
      </view>
        
      <view class="activity-status">
        <text class="status-badge {{getActivityStatus(activity)}}">{{getActivityStatusText(activity)}}</text>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{filteredActivities.length === 0}}">
        <text class="empty-text">该日期暂无活动</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="btn btn-primary" bindtap="onToday">
      <text>今天</text>
    </button>
      
    <button class="btn btn-secondary" bindtap="onPrevMonth">
      <text>上个月</text>
    </button>
      
    <button class="btn btn-secondary" bindtap="onNextMonth">
      <text>下个月</text>
    </button>
  </view>
</view>