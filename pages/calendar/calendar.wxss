/* pages/calendar/calendar.wxss */
.calendar-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 日历头部样式 */
.calendar-header {
  background: linear-gradient(135deg, #1890ff 0%, #52c41a 100%);
  color: white;
  padding: 20rpx 30rpx;
}

.header-title {
  justify-content: space-between;  /* 使左按钮和右按钮分别靠左和靠右 */
  align-items: center;  /* 垂直居中对齐 */
  display: flex;
}

.title-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;  /* 使标题和日期居中 */
  flex-grow: 1;  /* 让标题区域占据可用空间 */
}

.title-text {
  font-size: 36rpx;
  font-weight: bold;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.title-btn {
  color: black;
  border: none;
  font-size: 30rpx;
  cursor: pointer;
}

.view-switcher {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.view-item {
  padding: 12rpx 24rpx;
  margin: 0 10rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.view-item.active {
  background-color: rgba(255, 255, 255, 0.2);
}



/* 星期标题样式 */
.week-header {
  display: flex;
  background-color: white;
}

.weekday {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
}

.weekday:nth-child(1),
.weekday:nth-child(7) {
  color: #ff4d4f;
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
  background-color: white;
}

.day-item {
  width: 13.7%;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  margin: 2rpx;
  position: relative;
}

.day-item.current-month {
  color: #333;
}

.day-item.other-month {
  color: #ccc;
}

.day-item.today {
  background-color: #e6f7ff;
}

.day-item.selected {
  background-color: #1890ff;
  color: white;
}

.day-number {
  font-size: 28rpx;
  font-weight: bold;
}

/* 活动标记样式 */
.activity-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: #ffffff00;
}

.activity-dot.has-activities {
  width: 11rpx;
  height: 11rpx;
  background-color: #52c41a;
}

.activity-dot.selected {
  background-color: #ffffff;
}

/* 活动列表样式 */
.activities-section {
  background-color: white;
  margin: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.activity-info {
  padding: 30rpx;              /* 内边距 */
}

.activity-title {
  flex: 1;                     /* 占据剩余空间 */
  font-size: 32rpx;            /* 字体大小 */
  font-weight: 600;            /* 字体粗细 */
  color: #333;                 /* 字体颜色 */
  line-height: 1.4;            /* 行高 */
  margin-right: 20rpx;         /* 右侧外边距 */
  display: -webkit-box;        /* 弹性盒子 */
  -webkit-line-clamp: 2;       /* 限制两行 */
  -webkit-box-orient: vertical;  /* 垂直方向 */
  overflow: hidden;             /* 隐藏溢出内容 */
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
}

.activities-list {
  padding: 20rpx;
}

.empty-day-wrapper {
  display: flex;
  padding: 20rpx 30rpx;
}

.empty-day {
  text-align: center;
  font-size: 32rpx;
  color: black;
}