/* Home specific overrides if needed */
.banner { height: 300rpx; margin: 24rpx; border-radius: 16rpx; overflow: hidden; }
.banner-img { width: 100%; height: 100%; display: block; }
.section-more {
  margin-right: 0rpx;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #ddd;
  font-size: 26rpx;
  line-height: 1.6;
  color: #666;
}
.club-scroll {
  margin-top: 16rpx;
  padding: 8rpx 0;
}

/* 用 nowrap + inline-block 来横向排布 */
.club-list {
  white-space: nowrap;
}

.club-item {
  display: inline-block;
  width: 140rpx;
  height: 160rpx;
  align-items: center;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 16rpx;
  background: #f5f5f5;
  vertical-align: top;
  padding: 0;          /* 覆盖 button 自带 padding */
}

/* 干掉 button 默认的点击边框效果 */
button.club-item::after {
  border: none;
}

.club-img {
  width: 140rpx;
  height: 110rpx;
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 2rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

/* 6种漂亮的纯色方案 */
.color-bg-0 {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.color-bg-1 {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.color-bg-2 {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
}

.color-bg-3 {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
}

.color-bg-4 {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
}

.color-bg-5 {
  background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
}

.club-initial {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}

.club-name {
  font-size: 22rpx;
  color: #333;
  text-align: center;
  margin-top: 4rpx;
  line-height: 1.4;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}