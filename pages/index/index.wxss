/* Home specific overrides if needed */
.banner { height: 300rpx; margin: 24rpx; border-radius: 16rpx; overflow: hidden; }
.banner-img { width: 100%; height: 100%; display: block; }
.section-more {
  margin-right: 0rpx;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #ddd;
  font-size: 26rpx;
  line-height: 1.6;
  color: #666;
}
.club-scroll {
  margin-top: 16rpx;
  padding: 8rpx 0;
}

/* 用 nowrap + inline-block 来横向排布 */
.club-list {
  white-space: nowrap;
}

.club-item {
  display: inline-block;
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 16rpx;
  background: #f5f5f5;
  vertical-align: top;
  padding: 0;          /* 覆盖 button 自带 padding */
}

/* 干掉 button 默认的点击边框效果 */
button.club-item::after {
  border: none;
}

/* 图片占上面大部分 */
.club-img {
  width: 100%;
  height: 100rpx;
  display: block;
}

/* 名字放下面一条，保持方块总高度 140rpx */
.club-name {
  display: block;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #333;
  background: #ffffff;
}