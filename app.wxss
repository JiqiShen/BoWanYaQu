page { background: #ffffff; }
.section { background: #e5e5e5; border-radius: 16rpx; padding: 24rpx; margin: 24rpx; }
.h-title { font-size: 36rpx; font-weight: 600; margin-bottom: 16rpx; }
.card { border-radius: 12rpx; padding: 24rpx; margin: 16rpx 0; box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.06); }
.row { display:flex; align-items:center; }
.space-between { justify-content: space-between; }
.banner { margin: 24rpx; height: 220rpx; border-radius: 16rpx; background: #cfcfcf; }
.square { width: 140rpx; height: 140rpx; border-radius: 16rpx; }
.grid { display: flex; gap: 40rpx; flex-wrap: nowrap; }
.muted { color: #666; font-size: 26rpx; }